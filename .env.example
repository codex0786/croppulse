# CropPulse configuration (copy to .env). Placeholders only — never commit real values.
CROPPULSE_ENVIRONMENT=development
# SQLite for local development; PostgreSQL (PostGIS image in docker-compose) for anything shared.
# Default: SQLite at <repo>/data/croppulse.db. Example for PostgreSQL:
# CROPPULSE_DATABASE_URL=postgresql+psycopg://croppulse:CHANGE_ME@localhost:5432/croppulse
# Required in production (>= 32 chars): python -c 'import secrets; print(secrets.token_urlsafe(48))'
CROPPULSE_SECRET_KEY=
CROPPULSE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CROPPULSE_ENABLE_LIVE_SOURCES=true
# NASA Earthdata user token (GPM IMERG, SMAP). Empty = sources reported as not_configured.
CROPPULSE_EARTHDATA_TOKEN=
CROPPULSE_NOTIFICATION_EMAIL_PROVIDER=dev_outbox
CROPPULSE_FEATURE_YIELD_PREDICTION=false
CROPPULSE_FEATURE_MARKET_PRICES=false
CROPPULSE_LOG_LEVEL=INFO
# Frontend
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
